class Car:
    def __init__(self, color, model, max_speed):
        self.color = color
        self.model = model
        self.max_speed = max_speed

    def drive_in(self, location):
        self.location = location

    def change_color(self, new_color):
        self.color = new_color



car_1 = Car('red', 'kia', 150)
car_2 = Car('black', 'bwb', 730)
print(car_2)


